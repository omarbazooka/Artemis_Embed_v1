{
  "base_model": "answerdotai/ModernBERT-base",
  "teacher_model": "Qwen/Qwen3-Embedding-0.6B",
  "quick_mode": true,
  "max_length": 128,
  "train_per_source": 1800,
  "dev_pairs": 400,
  "sts_dev_size": 700,
  "cls_train_size": 1200,
  "cls_test_size": 500,
  "batch_size": 12,
  "grad_accum": 2,
  "eval_batch_size": 64,
  "lr_full": 2e-05,
  "lr_lora": 0.00015,
  "weight_decay": 0.01,
  "warmup_ratio": 0.08,
  "max_grad_norm": 1.0,
  "temperature": 0.05,
  "steps_full": 120,
  "steps_lora": 220,
  "steps_distill": 240,
  "dims": [768, 512, 256, 128],
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "hard_negative_weight": 0.25,
  "gor_weight": 0.01,
  "distill_weight": 0.35,
  "run_full_ft": true,
  "run_lora": true,
  "run_gor": true,
  "run_teacher": true,
  "run_qlora": true,
  "out_dir": "/kaggle/working/artemis_embed_v1"
}
