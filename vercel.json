{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index.py"},
    {"source": "/docs", "destination": "/api/index.py"},
    {"source": "/redoc", "destination": "/api/index.py"},
    {"source": "/openapi.json", "destination": "/api/index.py"}
  ]
}
