# Artemis model registry / remote inference
HF_MODEL_ID=Omarbm52/Artemis-Embed-v1
# Preferred when Artemis is served by Kaggle or another custom runtime.
# Example: https://your-tunnel.trycloudflare.com/embed
HF_EMBEDDING_URL=
# Required only when the selected remote endpoint expects Hugging Face auth.
HF_TOKEN=
HF_REQUEST_TIMEOUT_SECONDS=45

# Supabase document retrieval
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=artemis-documents

# Document ingestion limits
MAX_DOCUMENT_BYTES=5242880
MAX_DOCUMENT_CHUNKS=100
DOCUMENT_EMBEDDING_DIMENSION=256
CHUNK_WORDS=120
CHUNK_OVERLAP_WORDS=20
