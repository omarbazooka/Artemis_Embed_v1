# Hugging Face model serving
HF_MODEL_ID=your-hf-username/artemis-embed-v1
# Optional dedicated endpoint. Leave blank to derive a HF router URL from HF_MODEL_ID.
HF_EMBEDDING_URL=
HF_TOKEN=
HF_REQUEST_TIMEOUT_SECONDS=45

# Supabase document retrieval
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=artemis-documents

# Document ingestion limits
MAX_DOCUMENT_BYTES=5242880
MAX_DOCUMENT_CHUNKS=100
DOCUMENT_EMBEDDING_DIMENSION=256
CHUNK_WORDS=120
CHUNK_OVERLAP_WORDS=20
